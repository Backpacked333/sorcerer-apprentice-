# ---- ElevenLabs (required for voice; everything runs in text/mock mode without it) ----
ELEVENLABS_API_KEY=
# Agent ids come from `npm run agents:create` (or the dashboard). Public agents only need the id.
NEXT_PUBLIC_INTERVIEWER_AGENT_ID=
NEXT_PUBLIC_TUTOR_AGENT_ID=
# Voice used by both agents (any ElevenLabs voice id). Leave empty to keep the agent default.
ELEVENLABS_VOICE_ID=

# ---- Vision + compile models (Vercel AI Gateway: one key for every provider) ----
# Get a key at vercel.com -> AI Gateway. List model slugs: curl https://ai-gateway.vercel.sh/v1/models
AI_GATEWAY_API_KEY=
VISION_MODEL=anthropic/claude-haiku-4.5
COMPILE_MODEL=anthropic/claude-sonnet-4.5

# ---- Event source for the capture pipeline ----
# vision = frames go to the vision model, one every second or two (the brief's path)
# both   = vision stays primary; the sandbox ERP's own telemetry waits 2.5 s and only fills in what vision missed
#          (events show "seen" when the vision model saw them, "erp" when only the ERP reported them)
# dom    = ERP telemetry only (keyless development, emergency fallback)
NEXT_PUBLIC_EVENT_SOURCE=both

# ---- Durable anonymous workspaces ----
# On Vercel both Supabase values are required; local scripts stay keyless.
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=tacit-media
STORE_OWNER_ID=local

# ---- Governor tuning (seconds) ----
NEXT_PUBLIC_SILENCE_SECS=2.5
NEXT_PUBLIC_STILL_SECS=2
NEXT_PUBLIC_COOLDOWN_SECS=60
NEXT_PUBLIC_MAX_QUESTIONS_PER_10MIN=5
